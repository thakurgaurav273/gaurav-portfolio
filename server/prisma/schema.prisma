generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id                   String    @id @default(cuid())
  email                String    @unique
  password             String
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  sessions             AdminSession[]
  challenges           LoginChallenge[]
}

// A signed-in device. The refresh token rotates on every use; presenting the previous
// one again means it was copied, so the whole session is revoked.
model AdminSession {
  id           String    @id @default(cuid())
  adminId      String
  admin        Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  previousHash String?   @unique
  remember     Boolean   @default(false)
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  lastUsedAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([adminId])
}

// Second step of sign-in: a 6-digit code emailed after the password checks out.
model LoginChallenge {
  id         String    @id @default(cuid())
  adminId    String
  admin      Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  codeHash   String
  attempts   Int       @default(0)
  sendCount  Int       @default(1)
  lastSentAt DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([adminId])
}

// Failed sign-in attempts and sent codes, counted for lockouts and rate limits.
model AuthAttempt {
  id        String   @id @default(cuid())
  kind      String // password_fail | otp_fail | otp_sent | reset_request
  email     String?
  ipHash    String
  createdAt DateTime @default(now())

  @@index([kind, email, createdAt])
  @@index([kind, ipHash, createdAt])
}

// Single-row table holding the homepage intro.
model Hero {
  id          String   @id @default(cuid())
  name        String
  subtitle    String
  description String
  resumeUrl   String?
  about       String[] // About-section paragraphs
  socialLinks Json     @default("[]") // [{ platform, url }]
  stats       Json     @default("[]") // [{ value, label }]
  sections    Json     @default("{}") // { projects | experience | about | contact: { label, title, intro } }
  updatedAt   DateTime @updatedAt
}

model Experience {
  id          String    @id @default(cuid())
  company     String
  role        String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String[]
  tech        String[]
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Project {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String
  tagline      String?
  headline     String?
  subheadline  String?
  category     String?
  status       String   @default("live") // live | in-progress
  role         String?
  timeline     String?
  overview     String[] // case-study paragraphs
  architecture String[] // engineering notes for the case study
  features     String[]
  tech         String[]
  builtIn      String[]
  capabilities Json     @default("[]") // [{ icon, title, description }]
  screenshots  Json     @default("[]") // [{ url, alt, label, caption, orientation: 'desktop' | 'mobile' }]
  stack        Json     @default("[]") // [{ layer, name, note }]
  image        String?
  media        Json     @default("[]") // [{ url, type: 'image' | 'video' }]
  featured     Boolean  @default(false)
  link         String?
  githubUrl    String?
  liveUrl      String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Skill {
  id        String   @id @default(cuid())
  category  String
  items     String[]
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Accepted contact-form messages. Used for rate limiting (works across serverless
// instances) and as a backup if an email fails. IPs are stored hashed, never raw.
model ContactSubmission {
  id               String   @id @default(cuid())
  name             String
  email            String
  message          String
  ipHash           String
  emailSent        Boolean  @default(false)
  confirmationSent Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([email, createdAt])
  @@index([createdAt])
}

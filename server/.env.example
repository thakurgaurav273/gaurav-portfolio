# Neon: use the pooled connection string (host contains "-pooler") for the app,
# and the direct one for migrations. Both are on the Neon dashboard → Connect.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET="change-me"
SITE_URL="http://localhost:8080"      # used in password-reset links

# Optional: create/keep an admin when running `npm run db:seed`
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Contact form email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"
MY_EMAIL=""

# reCAPTCHA v3 secret (frontend uses VITE_RECAPTCHA_SITE_KEY)
SITE_SECRET_KEY=""

# Cloudinary (admin image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
